# Homebrew cask template. `Tools/release.sh` fills in the version and checksum
# and writes the result to build/release/daily-log.rb; copy that into
# AlbinAxtelius/homebrew-tap as Casks/daily-log.rb.
#
# The app is ad-hoc signed, not notarized, so install it with quarantine off:
#
#     brew tap albinaxtelius/tap
#     brew install --cask --no-quarantine daily-log
#
# Put `HOMEBREW_CASK_OPTS="--no-quarantine"` in your shell profile so
# `brew upgrade` does not re-quarantine it later.

cask "daily-log" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/AlbinAxtelius/daily_log/releases/download/v#{version}/daily_log-#{version}.zip"
  name "daily_log"
  desc "Menu-bar agent that nudges you to log what you are doing"
  homepage "https://github.com/AlbinAxtelius/daily_log"

  depends_on macos: ">= :tahoe"

  app "daily_log.app"

  # Launch-at-login is an SMAppService registration owned by the app itself, so
  # unregister it before the bundle disappears.
  uninstall launchctl: "se.axtelius.daily-log",
            quit:      "se.axtelius.daily-log"

  zap trash: "~/Library/Application Support/daily"
end

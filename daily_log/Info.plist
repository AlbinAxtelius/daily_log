<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Everything else in the bundle's Info.plist is generated by Xcode
	  (GENERATE_INFOPLIST_FILE = YES merges the keys below into it). This file
	  exists for one key that has no INFOPLIST_KEY_ equivalent:

	  Ask for Alerts rather than Banners the first time the app registers for
	  notifications. Banners auto-dismiss and fold their actions into an
	  "Options" menu; alerts stay put and draw the actions as buttons — the
	  whole point of a nudge you are meant to answer in one click.

	  This only sets the initial default. The user can still change it in
	  System Settings, it has no effect on a machine where the app has already
	  registered, and there is no API to change it at runtime.

	  The key predates UserNotifications.framework — it belongs to the
	  deprecated NSUserNotification API — so treat it as a hint, not a promise.
	-->
	<key>NSUserNotificationAlertStyle</key>
	<string>alert</string>
</dict>
</plist>
